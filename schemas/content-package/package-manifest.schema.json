    "packageKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
    },
    "site": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
        },
        "culture": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$(?![\\s\\S])"
        }
      },
      "required": [
        "key",
        "culture"
      ],
      "additionalProperties": false
