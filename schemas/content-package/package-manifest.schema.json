  "required": [
    "format",
    "formatVersion",
    "packageKey",
    "site",
    "schemaVersions",
    "renderers",
    "contentTypes",
    "entries",
    "media",
    "taxonomies",
    "navigation",
    "routes",
    "redirects",
    "documentationSources"
