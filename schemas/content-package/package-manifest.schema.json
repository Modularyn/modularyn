                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      },
      "required": [
        "key",
        "type",
        "schemaVersion",
        "culture",
        "slug",
        "title",
        "layout",
        "template",
