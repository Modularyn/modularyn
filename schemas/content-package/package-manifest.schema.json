                "maxLength": 4096,
                "pattern": "[^\\s]"
              }
            },
            "required": [
              "kind",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "heading"
              },
              "level": {
                "type": "integer",
                "minimum": 2,
                "maximum": 6
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "[^\\s]"
              }
            },
            "required": [
              "kind",
              "level",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "image"
              },
              "media": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "[^\\s]"
              }
            },
            "required": [
              "kind",
              "media",
              "alt"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "content-link"
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "[^\\s]"
              }
            },
            "required": [
              "kind",
              "entry",
              "label"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    }
