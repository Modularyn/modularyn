{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modularyn:content-package:1:content-type",
  "title": "Content-package content type, format 1",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "[^\\s]"
    },
    "body": {
      "enum": [
        "markdown",
        "blocks"
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
              },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "boolean",
                  "date-time",
                  "media-ref"
                ]
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "type",
              "required"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
              },
              "type": {
                "const": "content-ref"
              },
              "required": {
                "type": "boolean"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
              }
            },
            "required": [
              "key",
              "type",
              "required",
              "target"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
              },
              "type": {
                "const": "term-ref"
              },
              "required": {
                "type": "boolean"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
              }
            },
            "required": [
              "key",
              "type",
              "required",
              "target"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    }
  },
  "required": [
    "formatVersion",
    "key",
    "schemaVersion",
    "name",
    "body",
    "fields"
  ],
  "additionalProperties": false
}
