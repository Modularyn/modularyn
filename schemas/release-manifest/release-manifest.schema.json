{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modularyn:release-manifest:1",
  "title": "Modularyn release manifest version 1",
  "description": "Release identity, profile tuples, edition and capability claims. Cross-reference, date and subset rules also require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "kind",
    "version",
    "sourceCommit",
    "channel",
    "edition",
    "license",
    "qualifiedSubset",
    "packages",
    "profiles",
    "capabilities"
  ],
  "properties": {
    "format": {
      "const": "modularyn.release-manifest"
    },
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "enum": [
        "release",
        "illustration"
      ]
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
    },
    "channel": {
      "enum": [
        "stable",
        "preview",
        "nightly"
      ]
    },
    "edition": {
      "$ref": "#/$defs/edition"
    },
    "license": {
      "enum": [
        "Apache-2.0",
        "PolyForm-Noncommercial-1.0.0"
      ]
    },
    "qualifiedSubset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "members"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "members": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability",
              "profile"
            ],
            "properties": {
              "capability": {
                "$ref": "#/$defs/text"
              },
              "profile": {
                "$ref": "#/$defs/profileKey"
              }
            }
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "edition"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/packageId"
          },
          "version": {
            "$ref": "#/$defs/semver"
          },
          "edition": {
            "$ref": "#/$defs/edition"
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "edition": {
          "const": "community"
        },
        "license": {
          "const": "Apache-2.0"
        }
      }
    },
    {
      "properties": {
        "edition": {
          "const": "standard"
        },
        "license": {
          "const": "PolyForm-Noncommercial-1.0.0"
        }
      }
    },
    {
      "properties": {
        "edition": {
          "const": "pro"
        },
        "license": {
          "const": "PolyForm-Noncommercial-1.0.0"
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?(?![\\s\\S])"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?![\\s\\S])"
    },
    "edition": {
      "enum": [
        "community",
        "standard",
        "pro"
      ]
    },
    "packageId": {
      "type": "string",
      "pattern": "^(?:Modularyn|dotnet-modularyn|Modularyn\\.(?:Framework|Modules|Cms|UI|Connectors|Pro|Tooling)(?:\\.(?:UI|(?:[A-Z][a-z0-9]+)+))+)(?![\\s\\S])"
    },
    "profileKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "versionedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(?:\\.(0|[1-9][0-9]*)){1,3}(?![\\s\\S])"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleVersions",
        "runtime",
        "database",
        "uiProfile",
        "tenancyMode",
        "deploymentTopology",
        "providers"
      ],
      "properties": {
        "moduleVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/packageId"
              },
              "version": {
                "$ref": "#/$defs/semver"
              }
            }
          }
        },
        "runtime": {
          "$ref": "#/$defs/versionedComponent"
        },
        "database": {
          "$ref": "#/$defs/versionedComponent"
        },
        "uiProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "packages"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/profileKey"
            },
            "packages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/packageId"
              }
            }
          }
        },
        "tenancyMode": {
          "$ref": "#/$defs/profileKey"
        },
        "deploymentTopology": {
          "$ref": "#/$defs/profileKey"
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "package",
              "version"
            ],
            "properties": {
              "role": {
                "$ref": "#/$defs/profileKey"
              },
              "package": {
                "$ref": "#/$defs/packageId"
              },
              "version": {
                "$ref": "#/$defs/semver"
              }
            }
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "entries"
      ],
      "properties": {
        "edition": {
          "$ref": "#/$defs/edition"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capabilityEntry"
          }
        }
      }
    },
    "capabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "profiles",
        "scope",
        "publicClaim"
      ],
      "properties": {
        "state": {
          "enum": [
            "Intended",
            "Designed",
            "Implemented",
            "Preview",
            "Qualified",
            "Deprecated",
            "Unsupported"
          ]
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/profileKey"
          }
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "publicClaim": {
          "enum": [
            "none",
            "planned",
            "supported"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "references"
            ],
            "properties": {
              "profile": {
                "$ref": "#/$defs/profileKey"
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        },
        "supportEndsOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      },
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "Intended"
            },
            "publicClaim": {
              "enum": [
                "none",
                "planned"
              ]
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "Designed"
            },
            "publicClaim": {
              "enum": [
                "none"
              ]
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "Implemented"
            },
            "publicClaim": {
              "enum": [
                "none"
              ]
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "Preview"
            },
            "publicClaim": {
              "enum": [
                "none"
              ]
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "Qualified"
            },
            "publicClaim": {
              "enum": [
                "none",
                "supported"
              ]
            }
          },
          "required": [
            "evidence"
          ]
        },
        {
          "properties": {
            "state": {
              "const": "Deprecated"
            },
            "publicClaim": {
              "enum": [
                "none",
                "supported"
              ]
            }
          },
          "required": [
            "supportEndsOn"
          ]
        },
        {
          "properties": {
            "state": {
              "const": "Unsupported"
            },
            "publicClaim": {
              "enum": [
                "none"
              ]
            }
          },
          "required": [
            "reason"
          ]
        }
      ]
    }
  }
}
