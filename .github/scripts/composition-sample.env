# The published sample image's settings for the container-build job's AC-001 run (docs/ci.md, "Container acceptance").
# composition-tests.sh passes this file to docker run with --env-file and adds the declared proxy, the address it measures.
# No secret is here: the database connection string is a mounted secret file.
Workspace__Database=secret:database
Workspace__DeploymentLock=/app/deployment-lock.json
Workspace__BlobDirectory=/var/lib/modularyn/blobs
Modularyn__Secrets__Directory=/run/modularyn/secrets
Modularyn__DataProtection__ApplicationName=Modularyn.TeamWorkspace.Ci
Modularyn__DataProtection__Directory=/var/lib/modularyn/keys
Modularyn__Ingress__PublicOrigins__0=https://modularyn-sample
Modularyn__Ingress__HttpsPort=443
Modularyn__Ingress__Limits__MaxRequestBodyBytes=10485760
